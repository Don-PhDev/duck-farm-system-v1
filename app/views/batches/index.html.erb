<% content_for :title, "Batches" %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-3xl font-bold">Batches</h1>
    <p class="text-slate-600 mt-1">Track all duck batches and their current status.</p>
  </div>

  <%= link_to "New Batch", new_batch_path, class: "rounded-xl bg-slate-900 px-4 py-2 text-white font-medium hover:bg-slate-800" %>
</div>

<div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
  <table class="min-w-full divide-y divide-slate-200">
    <thead class="bg-slate-100">
      <tr>
        <th class="px-4 py-3 text-left text-sm font-semibold">Batch Code</th>
        <th class="px-4 py-3 text-left text-sm font-semibold">Duck Type</th>
        <th class="px-4 py-3 text-left text-sm font-semibold">Arrival Date</th>
        <th class="px-4 py-3 text-right text-sm font-semibold">Initial Ducks</th>
        <th class="px-4 py-3 text-right text-sm font-semibold">Sold</th>
        <th class="px-4 py-3 text-right text-sm font-semibold">Dead</th>
        <th class="px-4 py-3 text-right text-sm font-semibold">Remaining</th>
        <th class="px-4 py-3 text-right text-sm font-semibold">Gross Profit</th>
        <th class="px-4 py-3 text-left text-sm font-semibold"></th>
      </tr>
    </thead>

    <tbody class="divide-y divide-slate-100">
      <% @batches.each do |batch| %>
        <tr class="hover:bg-slate-50">
          <td class="px-4 py-3 font-medium"><%= batch.batch_code %></td>
          <td class="px-4 py-3"><%= batch.duck_type %></td>
          <td class="px-4 py-3"><%= batch.arrival_date&.strftime("%b %d, %Y") %></td>
          <td class="px-4 py-3 text-right"><%= batch.initial_duck_count %></td>
          <td class="px-4 py-3 text-right"><%= batch.ducks_sold %></td>
          <td class="px-4 py-3 text-right"><%= batch.ducks_dead %></td>
          <td class="px-4 py-3 text-right font-semibold"><%= batch.remaining_ducks %></td>
          <td class="px-4 py-3 text-right">₱<%= number_with_precision(batch.gross_profit, precision: 2, delimiter: ",") %></td>
          <td class="px-4 py-3 text-right">
            <%= link_to "View", batch_path(batch), class: "text-slate-700 hover:text-slate-900 font-medium" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
